# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME="StudioSync"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://your-server-domain-or-ip
APP_PORT=80

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# =============================================================================
# Database (PostgreSQL inside Docker)
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=studiosync
DB_USERNAME=postgres
DB_PASSWORD=change_this_to_a_strong_secret_password
# Port mapped to host (127.0.0.1:5432 prevents exposing db to public internet)
FORWARD_DB_PORT=127.0.0.1:5432

# =============================================================================
# Redis & Cache / Session / Queue
# =============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=127.0.0.1:6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis

# =============================================================================
# Automated Startup Tasks
# =============================================================================
# Automatically execute database migrations on container startup
AUTORUN_MIGRATIONS=true
# Set to true only on first deployment if you need to run initial seeders (RoleSeeder, UserSeeder)
AUTORUN_SEEDER=false

# =============================================================================
# Storage & Cloud Filesystem
# =============================================================================
FILESYSTEM_DISK=local

# AWS S3 (Optional - if using S3 for project assets)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (Optional)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false
CLOUDFLARE_R2_URL=

# =============================================================================
# Mail Configuration
# =============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# Vercel Deployment Integration (StudioSync Website Builder)
# =============================================================================
VERCEL_API_TOKEN=
# Leave VERCEL_TEAM_ID empty for Personal accounts
VERCEL_TEAM_ID=
VERCEL_WEBHOOK_SECRET=

# =============================================================================
# Frontend
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
